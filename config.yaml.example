# Copy to config.yaml next to app.py or app.exe.
HOST_IP: '127.0.0.1'
PORT: 7000

# Optional; HTTP clients send X-API-Key when this is configured.
# LIGHT_ALARM_API_KEY takes precedence over this value.
API_KEY: ''

SSL:
  ENABLED: false
  CERT_PATH: ''
  KEY_PATH: ''

TIMING:
  DEFAULT_DURATION: 5
  CONNECT_TIMEOUT: 5
  RESPONSE_TIMEOUT: 5
  DATABASE_TIMEOUT: 5

CH9120:
  COMMANDS:
    FLASH_ONLY: '0110001A0001028E19'
    READ_ALL: 'A00AAA0A'
    TQC1: '0110001A00040101000137FF'
    TQC2: '0110001A00040101000277FE'
    TQC3: '0110001A000401010003B63E'
    TQC_SEWING: '0110001A00040101000137FF'
    TURN_OFF: '0110001A0001000FD8'
    # Configure the supplier-provided command before using office alerts.
    # OFFICE: '<HEX command>'

DATABASE: 
  SQL_SERVER: 'SERVER_IP,PORT'
  SQL_DATABASE: 'DATABASE_NAME'
  SQL_USER: 'USER'
  SQL_PASSWORD: 'PASSWORD'
  SQL_DRIVER: 'ODBC Driver 17 for SQL Server'
